<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/resourceTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Resource Title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#174A72"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/resourceSubject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Subject: Computer Science"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/resourceTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/resourceDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Resource description appears here."
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/resourceSubject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/resourceType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PDF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#174A72"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/resourceDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
