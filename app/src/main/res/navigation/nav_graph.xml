
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.masomoshare254.ui.dashboard.DashboardFragment"
        android:label="Dashboard">

        <action
            android:id="@+id/action_dashboard_to_feature"
            app:destination="@id/featureFragment" />

        <action
            android:id="@+id/action_dashboard_to_resources"
            app:destination="@id/resourcesFragment" />

    </fragment>

    <fragment
        android:id="@+id/resourcesFragment"
        android:name="com.example.masomoshare254.ui.resources.ResourcesFragment"
        android:label="Browse Resources">

        <action
            android:id="@+id/action_resources_to_details"
            app:destination="@id/resourceDetailsFragment" />

    </fragment>

    <fragment
        android:id="@+id/resourceDetailsFragment"
        android:name="com.example.masomoshare254.ui.resources.ResourceDetailsFragment"
        android:label="Resource Details">

        <argument
            android:name="resourceId"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/featureFragment"
        android:name="com.example.masomoshare254.ui.feature.FeatureFragment"
        android:label="Feature">

        <argument
            android:name="screenTitle"
            app:argType="string" />

        <argument
            android:name="screenDescription"
            app:argType="string" />

    </fragment>

</navigation>
