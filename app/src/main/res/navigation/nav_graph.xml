<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.masomoshare254.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.masomoshare254.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.masomoshare254.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_feature"
            app:destination="@id/featureFragment" />
        <action
            android:id="@+id/action_dashboard_to_resources"
            app:destination="@id/resourcesFragment" />
    </fragment>

    <fragment
        android:id="@+id/resourcesFragment"
        android:name="com.example.masomoshare254.ui.resources.ResourcesFragment"
        android:label="Browse Resources" />

    <fragment
        android:id="@+id/featureFragment"
        android:name="com.example.masomoshare254.ui.feature.FeatureFragment"
        android:label="Feature">
        <argument
            android:name="screenTitle"
            app:argType="string" />
        <argument
            android:name="screenDescription"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/pdfViewerFragment"
        android:name="com.example.masomoshare254.ui.feature.FeatureFragment"
        android:label="PDF Viewer" />

</navigation>
